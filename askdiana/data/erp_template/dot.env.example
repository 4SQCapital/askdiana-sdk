ASKDIANA_API_KEY=askd_your_key_here
ASKDIANA_VERIFY_SSL=true

LLM_PROVIDER=openai
LLM_URL=https://genius2.4sqcapital.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=genius2

# --- Connect page: needed for any login other than a single oauth2 ---
EXTENSION_PUBLIC_URL=https://your-extension-host

DEMO_WHEN_DISCONNECTED=true
ERP_CACHE_TTL_SECONDS=300

# --- Only if the pack has an oauth2 login: the env names you set in client_id_env / client_secret_env ---
# VENDOR_CLIENT_ID=
# VENDOR_CLIENT_SECRET=

# --- Only when AskDiana itself runs on-prem: networks the extension may reach ---
# ERP_PRIVATE_NETWORKS=10.0.0.0/8
